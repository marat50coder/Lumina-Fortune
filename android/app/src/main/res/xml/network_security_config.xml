<?xml version="1.0" encoding="utf-8"?>
<!--
    cleartextTrafficPermitted="true" on `base-config` is intentional
    and mandatory: some push and landing chains route through
    `http://…` intermediates, and a "false" base with per-domain
    whitelisting silently breaks the next time a sub-domain is
    renamed.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
