<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ splash icon. Must be an AdaptiveIconDrawable — a
    flat PNG silently falls back to the launcher-icon and looks
    clipped (pitfalls doc §16 / project brief). Kept byte-for-byte
    equivalent to mipmap-anydpi-v26/ic_launcher.xml so the
    desktop and splash images match.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launch_bg"/>
    <foreground>
        <inset
            android:drawable="@drawable/ic_launcher_foreground"
            android:inset="14%"/>
    </foreground>
</adaptive-icon>
