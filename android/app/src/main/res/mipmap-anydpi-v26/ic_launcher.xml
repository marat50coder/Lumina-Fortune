<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher icon. Every launcher mask (Pixel circle,
    squircle, teardrop) trims only the launch_bg tone around the
    inset foreground — the artwork never gets clipped. Identical
    to drawable-anydpi-v26/ic_splash_logo.xml so the Android 12+
    splash matches the desktop icon exactly.

    Inset matches Towerbound (17%). A larger inset leaves a solid
    launch_bg ring around the artwork.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launch_bg"/>
    <foreground>
        <inset
            android:drawable="@drawable/ic_launcher_foreground"
            android:inset="17%"/>
    </foreground>
</adaptive-icon>
